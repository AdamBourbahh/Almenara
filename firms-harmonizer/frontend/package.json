{
  "name": "firms-harmonizer-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "GPU dashboard (Deck.gl + MapLibre + Canvas 2D) for MODIS/VIIRS fire radiative energy harmonization",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@deck.gl/aggregation-layers": "~9.4.1",
    "@deck.gl/core": "~9.4.1",
    "@deck.gl/geo-layers": "~9.4.1",
    "@deck.gl/layers": "~9.4.1",
    "@deck.gl/react": "~9.4.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "h3-js": "^4.5.0",
    "lucide-react": "^1.73.0",
    "maplibre-gl": "^6.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "maplibre-gl": "$maplibre-gl",
    "@loaders.gl/compression": {
      "fflate": "0.7.5"
    },
    "@loaders.gl/core": "4.5.4",
    "@loaders.gl/gltf": "4.5.4",
    "@loaders.gl/textures": "4.5.4"
  }
}
