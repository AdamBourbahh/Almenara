# Environment variables for FIRMS-Harmonizer
# Copy to .env and configure as needed.

# Fire Copilot: optional prose and question interpretation via Groq.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Set to 1 for deterministic local answers without any external requests.
COPILOT_OFFLINE=0

# Live Web Grounding Search (optional free search key, defaults to DuckDuckGo search if unset)
TAVILY_API_KEY=

# Optional NASA FIRMS API key for NRT ingest
FIRMS_MAP_KEY=

# Real observations are the default. Set 1 only to opt into synthetic demonstrations.
USE_SYNTHETIC_CUBE=0
