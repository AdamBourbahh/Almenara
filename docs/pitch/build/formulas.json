{
  "s1_overlap": "\\eta_{\\text{overlap}}(\\Delta T) = \\min\\left(1.0,\\, \\frac{1.0}{\\Delta T}\\right)",
  "s1_sigma": "\\Sigma_k = R(\\alpha)\\begin{pmatrix} (\\Delta S_k / 2.355)^2 & 0 \\\\ 0 & (\\Delta T_k / 2.355)^2 \\end{pmatrix} R(\\alpha)^\\top",
  "s1_area": "A_k = \\Delta S_k \\cdot \\Delta T_k > 3.5\\text{ km}^2",
  "s1_h3": "A_{\\text{H3}_7} = 5.161\\text{ km}^2",
  "s1_weight": "w_j \\propto \\exp\\left(-\\frac{1}{2}(x_j - \\mu_k)^\\top \\Sigma_k^{-1}(x_j - \\mu_k)\\right)",
  "s1_dag": "d_{\\text{H3}}(h_i, h_j) \\le k_{\\mathrm{m\\acute{a}x}} \\quad 0 \\le t_j - t_i \\le \\Delta t_{\\mathrm{m\\acute{a}x}}\\ (18\\text{ h})",
  "s1_fre": "\\text{FRE}_{\\text{evento}} = \\int_{t_{\\text{inicio}}}^{t_{\\text{fin}}} \\text{FRP}_{\\text{harm}}(t)\\, dt \\approx \\sum_{k=1}^{m-1} \\frac{\\text{FRP}_k + \\text{FRP}_{k+1}}{2}(t_{k+1} - t_k) \\cdot \\omega_{\\text{diurno}}(t_k, t_{k+1})",

  "s2_entropy": "H_{\\text{temp}}(h_{10}) = -\\frac{1}{\\ln(12)} \\sum_{m=1}^{12} p_m \\ln(p_m + 10^{-12}) \\in [0, 1]",
  "s2_thresholds": "H_{\\text{temp}} < 0.25 \\qquad H_{\\text{temp}} > 0.75",
  "s2_ir": "\\Delta T_{4/11} = T_4 - T_{11}",
  "s2_pos": "\\sigma_{\\text{pos}}^2 < 50\\text{ m}^2",
  "s2_h0": "H_0 = 0.72",
  "s2_sama": "\\Delta T_{11} < 1.5\\text{ K}",

  "s3_frpmin": "\\text{FRP}_{\\min}^{\\text{MODIS}} \\approx 8.0\\text{ MW} \\qquad \\text{FRP}_{\\min}^{\\text{VIIRS}} \\approx 0.5\\text{ MW}",
  "s3_pidet": "\\pi_{\\text{det}}(X_V, N_V, \\theta, c) = \\sigma\\left(\\beta_{0,c} + \\beta_{1,c}\\log(X_V) + \\beta_{2,c}N_V + \\beta_{3,c}\\sec(\\theta)\\right)",
  "s3_eqm": "\\hat{X}_{\\text{harm}} = F_{\\text{MODIS}|c,\\theta}^{-1}\\left(F_{\\text{VIIRS}|c,\\theta}(X_{\\text{VIIRS}})\\right)",
  "s3_gpd": "\\Delta E_{\\text{sub}}(\\theta, c) = \\pi_{\\text{sub}}(X_M, \\theta, c) \\int_{x_{\\min}^V}^{\\tau_M(\\theta, c)} x \\, f_{\\text{GPD}}(x; \\xi_c, \\sigma_c)\\, dx",
  "s3_w1": "W_1(F_{\\text{pre}}, F_{\\text{post}}) = \\int_0^\\infty |F_{\\text{pre}}(x) - F_{\\text{post}}(x)|\\, dx",
  "s3_chow": "F_{\\text{Chow}} = \\frac{(\\text{RSS}_{\\text{pooled}} - (\\text{RSS}_1 + \\text{RSS}_2)) / k}{(\\text{RSS}_1 + \\text{RSS}_2) / (N_1 + N_2 - 2k)} \\sim F(k, N_1 + N_2 - 2k)",

  "s4_ht": "\\widehat{\\text{FRE}}_{\\text{HT}}(h, t) = \\sum_{i \\in S(h,t)} \\frac{\\text{FRE}_i}{\\pi_{\\text{orb}}(\\phi_h) \\cdot (1 - C_{\\text{cloud}}(h, t))}",
  "s4_piorb": "\\pi_{\\text{orb}}(\\phi_h) \\propto \\cos^{-1}(\\phi_h)",
  "s4_kappa": "\\kappa(\\tau_s) = \\text{FRP}_{13:30} / \\text{FRP}_{10:30}",
  "s4_mucross": "\\mu_{\\text{cross}}(d) = \\frac{\\sum_{y=2001}^{2026} \\sum_{\\tau=1}^{366} K_{\\text{circ}}(d, \\tau; \\sigma_d)\\, y_{\\text{fused}}(y, \\tau)}{\\sum_{y=2001}^{2026} \\sum_{\\tau=1}^{366} K_{\\text{circ}}(d, \\tau; \\sigma_d)\\, \\mathbb{I}(y_{\\text{fused}}(y, \\tau) \\text{ observed})}",
  "s4_xpred": "x_{t|t-1} = \\phi x_{t-1|t-1} + \\gamma u_{\\text{spatial}, t} + \\omega_{\\text{prior}} \\mu_{\\text{cross}}(d_t)",
  "s4_ppred": "P_{t|t-1} = \\phi^2 P_{t-1|t-1} + Q_{\\text{var}} \\cdot (1 + 0.8 C_{\\text{cloud}, t})",
  "s4_gain": "S_{t,s} = h_{t,s}^2 P_{t|t-1} + R_s + 10^{-8}, \\quad K_{t,s} = \\frac{P_{t|t-1} h_{t,s}}{S_{t,s}}",
  "s4_joseph": "x_{t|t} = x_{t|t-1} + K_{t,s}(y_{t,s} - h_{t,s} x_{t|t-1}), \\quad P_{t|t} = (1 - K_{t,s} h_{t,s})^2 P_{t|t-1} + K_{t,s}^2 R_s",
  "s4_guard": "y_{\\text{guard}, t} = 0.55 \\mu_{\\text{cross}}(d_t) + 0.45 u_{\\text{spatial}, t} \\qquad R_{\\text{guard}} = 40.0",
  "s4_G": "G_t = \\frac{P_{t|t} \\phi}{P_{t+1|t} + 10^{-8}}",
  "s4_xs": "\\hat{x}_{t|T} = \\max\\left(0,\\, x_{t|t} + G_t(\\hat{x}_{t+1|T} - x_{t+1|t})\\right)",
  "s4_ps": "P_{t|T} = \\max\\left(10^{-4},\\, P_{t|t} + G_t^2(P_{t+1|T} - P_{t+1|t})\\right)",
  "s4_ci": "\\text{CI}_{95\\%}(t) = \\left[\\max\\left(0, \\hat{x}_{t|T} - 1.96\\sqrt{P_{t|T}}\\right),\\, \\hat{x}_{t|T} + 1.96\\sqrt{P_{t|T}}\\right]",

  "o_psi": "\\psi_d = \\frac{2\\pi d}{365.25} \\in [0, 2\\pi)",
  "o_moments": "\\bar{C}_y = \\frac{\\sum_d w_{d,y} \\cos\\psi_d}{\\sum_d w_{d,y} + 10^{-8}}, \\quad \\bar{S}_y = \\frac{\\sum_d w_{d,y} \\sin\\psi_d}{\\sum_d w_{d,y} + 10^{-8}}, \\quad \\bar{R}_y = \\sqrt{\\bar{C}_y^2 + \\bar{S}_y^2} \\in [0, 1]",
  "o_mu": "\\hat{\\mu}_y = (\\text{atan2}(\\bar{S}_y, \\bar{C}_y) \\bmod 2\\pi) \\cdot \\frac{365.25}{2\\pi}",
  "o_kappa": "\\hat{\\kappa}_y \\approx \\begin{cases} 2\\bar{R}_y + \\bar{R}_y^3 + \\frac{5}{6}\\bar{R}_y^5 & \\text{if } \\bar{R}_y < 0.53 \\\\ -0.4 + 1.39\\bar{R}_y + \\frac{0.43}{1 - \\bar{R}_y} & \\text{if } 0.53 \\le \\bar{R}_y < 0.85 \\\\ \\frac{1}{\\bar{R}_y^3 - 4\\bar{R}_y^2 + 3\\bar{R}_y} & \\text{if } \\bar{R}_y \\ge 0.85 \\end{cases}",
  "o_width": "W_y = \\min\\left(365.0,\\, \\frac{365.25}{\\sqrt{\\max(0.15, \\hat{\\kappa}_y)}}\\right)",
  "o_biomass": "M_{\\text{biomass}}(t) = 0.368 \\cdot \\hat{x}_{t|T} \\cdot A_{\\text{AOI}} \\quad [\\text{kg dry biomass}\\cdot\\text{day}^{-1}]",
  "o_emis": "E_{\\text{PM}_{2.5}}(t) = 10^{-3} \\cdot \\text{EF}_{\\text{PM}_{2.5}}(c) \\cdot M_{\\text{biomass}}(t), \\quad E_{\\text{CO}_2}(t) = 10^{-3} \\cdot \\text{EF}_{\\text{CO}_2}(c) \\cdot M_{\\text{biomass}}(t)",
  "o_forecast": "H = 14 \\qquad \\pm 1.96\\sqrt{P_{T+k|T}}"
}
